# Published Google Form /viewform or /formResponse URL.
JOIN_GOOGLE_FORM_ACTION_URL=
# Keep the entry. prefix in every field mapping below.
JOIN_GOOGLE_FORM_ENTRY_AUDIENCE=
JOIN_GOOGLE_FORM_ENTRY_NAME=
JOIN_GOOGLE_FORM_ENTRY_AGE_GRADE=
JOIN_GOOGLE_FORM_ENTRY_ORGANIZATION=
JOIN_GOOGLE_FORM_ENTRY_CITY=
JOIN_GOOGLE_FORM_ENTRY_CONTACT=
JOIN_GOOGLE_FORM_ENTRY_INTERESTS=
JOIN_GOOGLE_FORM_ENTRY_MESSAGE=
JOIN_GOOGLE_FORM_ENTRY_LANGUAGE=
JOIN_GOOGLE_FORM_ENTRY_SUBMITTED_AT=
JOIN_GOOGLE_FORM_ENTRY_PAGE=
JOIN_NOTIFICATION_WEBHOOK_URL=

# Browser-safe Supabase configuration.
VITE_SUPABASE_URL=https://sronjswselrxewaqfcar.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional future override. Leave empty while the community lives at /community
# on the same origin as the public website.
VITE_COMMUNITY_ORIGIN=

# Collaborative Field Note editor. Leave the browser URL empty in production
# to use the same-origin /api/community/field-note-collaboration endpoint.
VITE_COMMUNITY_COLLAB_URL=ws://127.0.0.1:1234

# Vercel Functions use the same publishable key with the caller's JWT.
SUPABASE_URL=https://sronjswselrxewaqfcar.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Branded Supabase Auth email delivery through Vercel and Resend. Keep both
# secrets server-only; never add VITE_ or NEXT_PUBLIC_ prefixes.
RESEND_API_KEY=
SUPABASE_SEND_EMAIL_HOOK_SECRET=
AUTH_EMAIL_FROM="阿柑少年 <no-reply@auth.rganjunior.org>"

# Required by the collaborative editor API and WebSocket server. Never prefix
# this with VITE_ and never expose it to browser code.
# SUPABASE_SECRET_KEY=sb_secret_replace_me

# Community server endpoints. Generate independent high-entropy secrets; keep
# every value server-only. The encryption key must be 32 random bytes in base64.
COMMUNITY_PUBLIC_URL=https://www.rganjunior.org
GUARDIAN_HASH_SECRET=
GUARDIAN_DATA_ENCRYPTION_KEY=

# Hocuspocus/Yjs collaboration. Production must configure a TLS Redis URL so
# multiple Vercel Function instances share updates and awareness. Local single-
# instance development may leave Redis empty and run `npm run dev:collab`.
COMMUNITY_COLLAB_REDIS_URL=
COMMUNITY_COLLAB_INSTANCE_NAME=
COMMUNITY_COLLAB_PORT=1234

# Production delivery adapters. Endpoints receive JSON over HTTPS with a
# Bearer token and must deliver the configured invite/SMS templates.
GUARDIAN_INVITE_WEBHOOK_URL=
GUARDIAN_INVITE_WEBHOOK_SECRET=
GUARDIAN_OTP_WEBHOOK_URL=
GUARDIAN_OTP_WEBHOOK_SECRET=
